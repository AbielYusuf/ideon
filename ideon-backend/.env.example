# Copy this file to .env and fill in your own values.
# Never commit the resulting .env file.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# --- Authentication -------------------------------------------------------
# Session lifetime in hours (default: 168 = 7 days).
IDEON_SESSION_TTL_HOURS=168
# Send Secure cookies. Set to true in production behind HTTPS.
IDEON_COOKIE_SECURE=false

# Initial administrator (used once by `python setup_admin.py`).
# Never commit real credentials. Leave the password unset to be prompted.
IDEON_ADMIN_USERNAME=admin
IDEON_ADMIN_EMAIL=admin@example.com
# IDEON_ADMIN_PASSWORD=
